rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function sequencePath() {
      return /databases/$(database)/documents/metadata/orderSequence;
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderNumber is int
        && request.resource.data.orderNumber > 0
        && getAfter(sequencePath()).data.lastOrderId == orderId
        && getAfter(sequencePath()).data.lastNumber == request.resource.data.orderNumber
        && (
          (exists(sequencePath())
            && request.resource.data.orderNumber == get(sequencePath()).data.lastNumber + 1)
          || (!exists(sequencePath()) && request.resource.data.orderNumber == 1)
        );
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /metadata/orderSequence {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['lastNumber', 'lastOrderId'])
        && request.resource.data.lastNumber == 1
        && request.resource.data.lastOrderId is string
        && !exists(orderPath(request.resource.data.lastOrderId))
        && getAfter(orderPath(request.resource.data.lastOrderId)).data.orderNumber == 1
        && getAfter(orderPath(request.resource.data.lastOrderId)).data.userId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['lastNumber', 'lastOrderId'])
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderId != resource.data.lastOrderId
        && !exists(orderPath(request.resource.data.lastOrderId))
        && getAfter(orderPath(request.resource.data.lastOrderId)).data.orderNumber == request.resource.data.lastNumber
        && getAfter(orderPath(request.resource.data.lastOrderId)).data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
